# Required
S3_BUCKET=your-private-bucket
AWS_REGION=us-east-1

# Optional
BIND_ADDR=0.0.0.0:3000
MAX_UPLOAD_BYTES=104857600
RUST_LOG=rust_s3_upload=info,tower_http=info

# Prefer an IAM role / workload identity in production.
# For local development, AWS SDK can read AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY from your environment or ~/.aws/credentials.
